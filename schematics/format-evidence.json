  "findings": [
    {
      "key": "container",
      "finding": "GZIP-compressed named NBT root compound Schematic; Materials TAG_String Alpha; Width/Height/Length TAG_Short. Both readers accept these; dimensions must stay positive signed-short values.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicFormat.javap.txt",
          "lines": [
            63,
            103
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicFormat.javap.txt",
          "lines": [
            142,
            156
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.ClipboardFormat$1.javap.txt",
          "lines": [
            12,
            27
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            19,
            90
          ]
        }
      ]
    },
    {
      "key": "dual_mapping",
      "finding": "SchematicaMapping and BlockMapping are distinct TAG_Compound tags. Both use exact registry-name keys and TAG_Short file-ID values. Schematica constructs file-ID→current registry ID using FML registry getId(name). WorldEdit constructs the same remap using Block.getBlockFromName(name)/getIdFromBlock. Include identical complete compounds, including air.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            293,
            326
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            384,
            405
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            190,
            233
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            510,
            527
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicWriter.javap.txt",
          "lines": [
            341,
            353
          ]
        }
      ]
    },
    {
      "key": "layout",
      "finding": "Blocks is one unsigned low-ID byte per cell; Data is one unsigned metadata byte per cell. Index is x + Width*(z + Length*y), X fastest then Z then Y. Metadata is placed metadata, not inventory item damage.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            335,
            405
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            478,
            550
          ]
        }
      ]
    },
    {
      "key": "addblocks_incompatibility",
      "finding": "Installed normal Schematica expands AddBlocks with even cell in high nibble and odd cell in low nibble; installed WorldEdit combines even cell from low nibble and odd from high. Therefore use only file-local IDs 0..255 and omit AddBlocks/Add/AddBlocks2. No need to encode runtime IDs. Do not re-save in either tool and assume cross-tool portability without rechecking high-ID output.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            214,
            276
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            689,
            775
          ]
        }
      ]
    },
    {
      "key": "schematicplus",
      "finding": "The installed Schematica config currently sets useSchematicplusFormat=false. The true branch expects an unpacked full-volume AddBlocks array even for low IDs. Proposed export requires false; it is not compatible with the alternative true branch.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            11,
            29
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            113,
            126
          ]
        },
        {
          "file": "verification/schematic-format-v1/installed-config-observation.json"
        }
      ]
    },
    {
      "key": "origin",
      "finding": "WorldEdit reads WEOriginX/Y/Z as clipboard region minimum, WEOffsetX/Y/Z as minimum minus clipboard anchor, and sets clipboard origin to WEOrigin minus WEOffset. Use all six TAG_Int values zero for a minimum-corner placement anchor; keep city/civil/world translation in sidecar manifest. Schematica Alpha reader does not consume these tags; position its ghost manually.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            91,
            186
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            466,
            473
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            11,
            449
          ]
        }
      ]
    },
    {
      "key": "entities",
      "finding": "Write empty TAG_List<Compound> TileEntities and Entities for architectural exports. Both read tile entity lists; WorldEdit requires and reads Entities. Schematica Alpha writes Entities but its readFromNBT does not load Entities. Exclude machines, inventories, multipart, shaped-block tile data, doors and other unvalidated tile/NBT content from this shell format.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            413,
            449
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            1228,
            1238
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            343,
            354
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",
          "lines": [
            628,
            678
          ]
        }
      ]
    },
    {
      "key": "air",
      "finding": "Export explicit air ID0 and metadata0 in every unoccupied bounding-box cell; it counts toward full array volume, not occupied shell bill. WorldEdit paste -a skips air; without -a the clipboard includes air and can clear destination cells. Installed command annotation and PasteBuilder connection confirm this behavior. File creation or loading is not a paste authorization.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.github.lunatrius.schematica.world.schematic.SchematicAlpha.javap.txt",
          "lines": [
            335,
            405
          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.extent.clipboard.io.SchematicReader.javap.txt",

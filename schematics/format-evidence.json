          ]
        },
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.command.ClipboardCommands.annotations.javap.txt",
          "lines": [
            811,
            846
          ]
        }
      ]
    },
    {
      "key": "active_worldedit_loader",
      "finding": "Installed //schematic load calls ClipboardFormat.getReader and uses SchematicReader, with aliases mcedit/mce/schematic. The separate obsolete MCEditSchematicFormat loader has no BlockMapping support; do not call that legacy Java API or claim general compatibility with every WorldEdit 6 build.",
      "evidence": [
        {
          "file": "verification/schematic-format-v1/com.sk89q.worldedit.command.SchematicCommands.javap.txt",
          "lines": [
            21,
            113
          ]
        },
